# Upstream's build output lives inside the submodule and is ignored there.

# The pinned secret scanner, downloaded and checksum-verified on first use by
# scripts/gitleaks-pin.sh. A cached binary, not source.
.tmp/

# The editor's Go workspace, generated by scripts/gowork.sh: it names core's
# backend and each unit here so gopls can resolve the extension surface. Its
# member list IS the unit set, so it is regenerated rather than tracked.
/go.work
/go.work.sum

# The editor's TypeScript project, generated by scripts/tsconfig-editor.sh, and
# the ambient reference it needs. Every path in it points into core/, whose
# layout is upstream's to change, so it is regenerated rather than tracked.
/tsconfig.json
/.tsc/

.DS_Store

# This installation's own env and deployment config, which is staged into core/
# (scripts/config-init.sh, `make config`). Ignored rather than tracked, for two
# different reasons:
#
#   .env.local            holds provider API keys. Never tracked.
#   config/ai-routing.yaml binds THIS machine's models — per-engineer by design,
#                         which is why upstream ignores it too.
#   config/margince.yaml  is per-installation and could reasonably be tracked:
#                         a secret field in it REFUSES a literal (it takes
#                         ${file:} or ${env:} only), so it carries no credential.
#                         Left ignored until somebody decides this repository
#                         should own one shared deployment config — that is a
#                         policy call, not a default.
.env
.env.local
/config/margince.yaml
/config/ai-routing.yaml

# The desktop build, mirrored out of the submodule by `make desktop-mirror`
# because core's `make clean` drops core/build/ wholesale. A 163M generated
# folder holding compiled Postgres, the bus and signed binaries — upstream
# ignores its own copy the same way (core/.gitignore, /build/desktop/).
#
# Anchored, and NOT a bare `build/`: this repo has no build system of its own,
# so an unrelated future /build asset should have to be ignored deliberately
# rather than inherit a blanket rule. Same reasoning core's own file gives.
/build/desktop/

# The all-in-one image's build context, assembled by scripts/aio.sh.
/build/aio/

# Trial bundles written by `make trial` (scripts/trial.sh). Each one holds a
# license in its margince.env, so none is ever tracked.
dist/

# The local stack of make local-up (scripts/local.sh): generated keys, the
# admin password and the rendered release files. Never tracked.
/.local/
