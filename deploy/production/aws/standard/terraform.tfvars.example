# Copy to terraform.tfvars and fill in.

# ---- Required ----------------------------------------------------------------

# MARGINCE_PUBLIC_BASE_URL: the canonical external scheme and host.
public_base_url = "https://crm.example.com"

# ACM certificate in aws_region covering the host in public_base_url.
# Request and validate it separately (DNS validation needs your own zone).
acm_certificate_arn = "arn:aws:acm:eu-central-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Copy the digest-pinned image references from one release of this instance:
# the release notes list them (docs/release.md). The registry is public
# (for example ghcr.io/<org> or docker.io/<org>); the stack pulls anonymously.
# Keep all three on the same release; Terraform does not build images.
image_refs = {
  api    = "<registry>/<instance-name>/api:<version>@sha256:<digest>"
  worker = "<registry>/<instance-name>/worker:<version>@sha256:<digest>"
  web    = "<registry>/<instance-name>/web:<version>@sha256:<digest>"
}

# Licence token issued for this installation.
license_token = "<licence token>"

# MARGINCE_ADMIN_PASSWORD for the first boot. Overwrite the SSM parameter
# with an inert value after the first boot (README.md, step 5).
admin_bootstrap_password = "change-me-before-first-boot"

# ---- Usually set ---------------------------------------------------------------

# alert_email = "ops@example.com"

# ---- Optional, shown with their defaults -----------------------------------------

# aws_region          = "eu-central-1"
# name_prefix         = "margince"
# az_count            = 2
# cpu_architecture    = "X86_64"            # "ARM64" needs multi-platform images
# db_instance_class   = "db.t4g.medium"
# db_multi_az         = true
# api_min_replicas    = 2
# api_max_replicas    = 4
# waf_mode            = "count"             # "block" after about a week of reviewing the WAF logs
