# No TLS here — CloudFront (cloudfront.tf) is the public-facing TLS
# terminator; this instance is CloudFront's origin, reached over plain
# HTTP inside AWS's own backbone. The shared-secret header check below is
# what stops a request from reaching here any other way (network.tf's
# origin-facing-prefix-list SG restriction is the first line; this is the
# second).
#
# Folds in two things that used to be separate: the api routing rules that
# mirror the full stack's ALB listener rules (../standard/alb.tf:
# aws_lb_listener_rule.api_v1_and_ops, api_webhooks, api_mcp_oauth), and the
# static-file-serving rules that used to belong to a separate "web"
# container's own nginx (frontend/nginx.conf) — there is no separate web
# process anymore, this instance serves the built frontend directly.

# ---- Request filtering (this stack has no WAF, by design for cost) --------
# Per-client-IP rate limits. This file is included inside nginx's http {}
# block (/etc/nginx/conf.d/), so the zones are declared here.
#
# Every request arrives from CloudFront, so the client address is taken
# from X-Forwarded-For: with real_ip_recursive off nginx uses the LAST
# entry, the viewer IP CloudFront itself appended, which a client cannot
# forge (any X-Forwarded-For it sends ends up in front of that entry).
# Trusting every source is safe only because network.tf's SG admits
# CloudFront's origin-facing range alone and the header check below
# rejects anything that did not come through this distribution.
# Same rule set as the Azure light stack: only the credential endpoints are
# limited, per client address, auth_rate_limit_per_minute with a burst of the
# same size. Microsoft sign-in (/v1/auth/oidc/*) is not limited: Entra
# protects its own side, and staff behind one office address would otherwise
# share one bucket.
limit_req_zone $binary_remote_addr zone=auth:10m rate=${auth_rate}r/m;
limit_req_status 429;
limit_req_log_level warn;

server {
    listen 80;
    server_name ${domain};
    root /opt/margince/frontend/dist;
    index index.html;

    set_real_ip_from 0.0.0.0/0;
    set_real_ip_from ::/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    if ($http_x_origin_verify != "${origin_verify_secret}") {
        return 403;
    }

    client_max_body_size 32m;

    location = /healthz  { proxy_pass http://${app_private_ip}:8080; }
    location = /readyz   { proxy_pass http://${app_private_ip}:8080; }
    # Prometheus metrics stay inside the VPC; CloudFront must not expose them.
    location = /metrics  { return 404; }

    location = /v1/auth/login {
        limit_req zone=auth burst=${auth_rate} nodelay;
        proxy_pass http://${app_private_ip}:8080;
    }
    location ~ ^/v1/auth/(forgot-password|reset-password) {
        limit_req zone=auth burst=${auth_rate} nodelay;
        proxy_pass http://${app_private_ip}:8080;
    }
    location /v1 { proxy_pass http://${app_private_ip}:8080; }
    location /setup/ {
        limit_req zone=auth burst=${auth_rate} nodelay;
        proxy_pass http://${app_private_ip}:8080;
    }

    location = /webhooks/gmail   { proxy_pass http://${app_private_ip}:8080; }
    location = /webhooks/graph   { proxy_pass http://${app_private_ip}:8080; }
    location = /webhooks/hubspot { proxy_pass http://${app_private_ip}:8080; }

    location = /oauth/token {
        limit_req zone=auth burst=${auth_rate} nodelay;
        proxy_pass http://${app_private_ip}:8080;
    }
    location /oauth/ { proxy_pass http://${app_private_ip}:8080; }
    location /mcp     { proxy_pass http://${app_private_ip}:8080; }
    location = /.well-known/oauth-authorization-server { proxy_pass http://${app_private_ip}:8080; }
    # Prefix, not exact: also covers /.well-known/oauth-protected-resource/mcp
    location /.well-known/oauth-protected-resource { proxy_pass http://${app_private_ip}:8080; }

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # ---- static frontend (was frontend/nginx.conf, baked into a separate
    # web container's image) ----------------------------------------------
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
    gzip_vary on;

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Referrer-Policy "no-referrer" always;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Referrer-Policy "no-referrer" always;
    }
    location /mcp-apps/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        add_header Referrer-Policy "no-referrer" always;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Referrer-Policy "no-referrer" always;
    }
}
