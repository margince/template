#cloud-config
# First boot of the Margince VM (vm.tf). cloud-init writes the configuration,
# helper scripts and systemd units, then runs margince-setup, which installs
# packages, mounts the data disk, builds Margince from source, bootstraps the
# database and starts the services. Progress: /var/log/margince-setup.log.
write_files:
%{ for path, f in files ~}
  - path: ${path}
    permissions: "${f.perm}"
    owner: root:root
    encoding: gz+b64
    content: ${f.b64}
%{ endfor ~}
runcmd:
  - [/usr/local/sbin/margince-setup]
