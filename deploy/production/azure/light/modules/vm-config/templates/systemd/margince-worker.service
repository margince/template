# cmd/worker: outbox relay, capture sync, retention and AI jobs. It runs no
# migrations and restarts until margince-api has applied them.
[Unit]
Description=Margince worker
Wants=network-online.target
After=network-online.target margince-api.service redis-server.service

[Service]
Type=simple
User=margince
Group=margince
WorkingDirectory=/app
Environment=PATH=/opt/margince/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/margince/app.env
EnvironmentFile=-/etc/margince/secrets.env
# Health and metrics on loopback only.
Environment=MARGINCE_OBSERVE_ADDR=127.0.0.1:9101
ExecStartPre=+/usr/local/sbin/margince-fetch-secrets
ExecStart=/opt/margince/current/bin/worker-entrypoint.sh
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
