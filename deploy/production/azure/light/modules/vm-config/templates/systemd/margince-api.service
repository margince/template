# cmd/api. The repository's api-entrypoint.sh applies migrations as the owner
# role, writes the first-boot admin password file, then starts margince-api
# on 127.0.0.1:8080 behind nginx (the margince-api wrapper margince-build
# installs sets the address).
[Unit]
Description=Margince api
Wants=network-online.target
After=network-online.target redis-server.service

[Service]
Type=simple
User=margince
Group=margince
WorkingDirectory=/app
Environment=PATH=/opt/margince/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/margince/app.env
EnvironmentFile=-/etc/margince/secrets.env
# "+" runs the fetch as root; it refreshes secrets.env from Key Vault.
ExecStartPre=+/usr/local/sbin/margince-fetch-secrets
ExecStart=/opt/margince/current/bin/api-entrypoint.sh
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
