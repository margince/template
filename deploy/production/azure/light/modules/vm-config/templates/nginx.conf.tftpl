# /etc/nginx/nginx.conf on the Margince VM, rendered by Terraform (vm.tf).
#
# nginx is the only public listener. It terminates TLS, serves the built SPA
# from /opt/margince/current/frontend and forwards every api-owned path to
# cmd/api on 127.0.0.1:${api_port}, keeping the public Host header intact.
# The certificate files are a self-signed placeholder until
# margince-enable-tls links them to the Let's Encrypt certificate.

user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;

    # Access log without query strings, and with the capability tokens in
    # public links redacted: those paths are credentials.
    map $uri $log_path {
        ~^(?<cap>/v1/public/(preferences|confirm|booking|rooms))/  "$cap/[redacted]";
        default                                                     $uri;
    }
    log_format margince '$remote_addr "$request_method $log_path" $status '
                        '$body_bytes_sent $request_time "$http_user_agent"';
    access_log /var/log/nginx/access.log margince;

    # The VM's public IP sits on its own NIC with no proxy in front, so
    # $remote_addr is already the real client address.

    # Password login only from the break-glass ranges. Everyone else signs in
    # through Entra ID, where the customer's Conditional Access policy applies.
    geo $break_glass {
        default 0;
%{ for cidr in break_glass_cidrs ~}
        ${cidr} 1;
%{ endfor ~}
    }
    map "$request_method:$break_glass" $block_password_login {
        default   0;
        "POST:0"  1;
    }

    limit_req_zone $binary_remote_addr zone=auth:10m rate=${auth_rate}r/m;
    limit_req_status 429;

    upstream margince_api {
        server 127.0.0.1:${api_port};
        keepalive 16;
    }

    # Mozilla "intermediate": TLS 1.3 suites are fixed by OpenSSL; the list
    # below applies to TLS 1.2 only.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # ---- Port 80: ACME challenges, everything else to HTTPS -----------------
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;

        location /.well-known/acme-challenge/ {
            root /var/www/letsencrypt;
        }
        location = /livez {
            access_log off;
            return 200 "ok\n";
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ---- Loopback: MCP App views for cmd/api (MARGINCE_MCP_APPS_BASE_URL) ---
    server {
        listen 127.0.0.1:${mcp_apps_port};
        server_name _;
        root /opt/margince/current/frontend;
        access_log off;

        location /mcp-apps/ {
            try_files $uri =404;
        }
        location / {
            return 404;
        }
    }

    # ---- Port 443: Margince ------------------------------------------------
    server {
        listen 443 ssl http2 default_server;
        listen [::]:443 ssl http2 default_server;
        server_name _;

        ssl_certificate     ${tls_dir}/fullchain.pem;
        ssl_certificate_key ${tls_dir}/privkey.pem;

        root /opt/margince/current/frontend;
        index index.html;

        client_max_body_size 50m;

        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        # Report-only until the SPA has been checked against it; rename the
        # header to Content-Security-Policy to enforce.
        add_header Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

        gzip on;
        gzip_types text/css application/javascript application/json image/svg+xml;
        gzip_min_length 1024;
        gzip_vary on;

        # The api builds OAuth discovery URLs, the MCP challenge and webhook
        # signature bases from Host and X-Forwarded-Proto, so both carry what
        # the client used. X-Real-IP is the client address; Margince versions
        # that support MARGINCE_TRUSTED_PROXIES trust it from 127.0.0.1 only. X-Forwarded-For is
        # overwritten, never appended, so no client-supplied entry reaches the
        # api.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;

        # ---- api paths -----------------------------------------------------

        location = /v1/auth/login {
            if ($block_password_login) { return 403; }
            limit_req zone=auth burst=${auth_rate} nodelay;
            proxy_pass http://margince_api;
        }
        # Microsoft sign-in (/v1/auth/oidc/*) is not limited here: Entra
        # protects its own side, and staff behind one office address would
        # otherwise share one bucket.
        location ~ ^/v1/auth/(forgot-password|reset-password) {
            limit_req zone=auth burst=${auth_rate} nodelay;
            proxy_pass http://margince_api;
        }
        location = /oauth/token {
            limit_req zone=auth burst=${auth_rate} nodelay;
            proxy_pass http://margince_api;
        }
        location /setup/ {
            limit_req zone=auth burst=${auth_rate} nodelay;
            proxy_pass http://margince_api;
        }

        location /v1/          { proxy_pass http://margince_api; }
        location /webhooks/    { proxy_pass http://margince_api; }
        location /oauth/       { proxy_pass http://margince_api; }
        location /.well-known/oauth- { proxy_pass http://margince_api; }
        location = /healthz    { proxy_pass http://margince_api; }
        location = /readyz     { proxy_pass http://margince_api; }

        # MCP answers with a single-event text/event-stream; do not buffer it.
        location /mcp {
            proxy_buffering off;
            proxy_pass http://margince_api;
        }

        # Prometheus metrics stay on the VM.
        location = /metrics { return 404; }

        # Liveness of nginx itself, independent of cmd/api.
        location = /livez {
            access_log off;
            return 200 "ok\n";
        }

        # ---- SPA -----------------------------------------------------------

        location /assets/ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";
            add_header Referrer-Policy "no-referrer" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        # A location with its own add_header drops the server-level ones, so
        # the app shell repeats every security header.
        location = /index.html {
            add_header Cache-Control "no-cache";
            add_header Referrer-Policy "no-referrer" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        }

        location /mcp-apps/ {
            try_files $uri =404;
            add_header Cache-Control "no-cache";
            add_header Referrer-Policy "no-referrer" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
