# Copy to terraform.tfvars and fill in.

# ---- Required ----------------------------------------------------------------

# MARGINCE_PUBLIC_BASE_URL: the canonical external scheme and host.
public_base_url = "https://crm.example.com"

# Copy the digest-pinned image references from one release of this instance:
# the release notes list them (docs/release.md). Keep all three on the same
# release; Terraform does not build images.
image_refs = {
  api    = "<registry>/<instance-name>/api:<version>@sha256:<digest>"
  worker = "<registry>/<instance-name>/worker:<version>@sha256:<digest>"
  web    = "<registry>/<instance-name>/web:<version>@sha256:<digest>"
}

# If the registry requires authentication, set both. Terraform stores
# the password in Key Vault and Container Apps references it from there.
# source_registry_username = "<user>"
# source_registry_password = "<token>"

# Licence token issued for this installation.
license_token = "<licence token>"

# MARGINCE_ADMIN_PASSWORD for the first boot. Set include_bootstrap_admin =
# false once the first admin has signed in (README.md, step 6).
admin_bootstrap_password = "change-me-before-first-boot"

# SSH public key for the jumpbox: ssh-keygen -t ed25519 (RSA also works).
jumpbox_ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# ---- Usually set ---------------------------------------------------------------

# false on the first apply; true once images, database, margince.yaml and the
# public certificate exist (README.md, step 5).
deploy_apps = false

# Your public IP while you set up or push images from a laptop
# (curl -s https://api.ipify.org). Set back to [] afterwards.
operator_ip_allowlist = ["203.0.113.20"]

# Key Vault Administrator for these Entra object IDs, ideally one group with
# every operator and the CI identity. Empty: whoever runs terraform apply.
# key_vault_admin_principal_ids = ["00000000-0000-0000-0000-000000000000"]

# alert_email = "ops@example.com"

# ---- Optional, shown with their defaults -----------------------------------------

# azure_region            = "westeurope"
# name_prefix             = "margince"          # also the resource group name
# db_sku_name             = "B_Standard_B2s"    # "GP_Standard_D2ds_v5": Microsoft's production recommendation
# db_zone_redundant_ha    = false               # true needs a GP_ or MO_ SKU
# api_min_replicas        = 3
# api_max_replicas        = 6
# waf_mode                = "count"             # "block" after about a week of reviewing the WAF logs
# include_bootstrap_admin = true                # false after the first admin login
# enable_resource_locks   = true                # set false and apply before terraform destroy
