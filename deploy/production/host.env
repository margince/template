# deploy/production/host.env — the host adapter's server (docs/deploy.md).
# Read as KEY=VALUE lines; not executed.
# the server to deploy to, e.g. ubuntu@203.0.113.10 (user@host; no IPv6, no port) — fill this in
HOST_SSH=
# the public domain name the server answers on, e.g. crm.example.com — fill this in
HOST_DOMAIN=
