# Caddyfile — the host adapter's HTTPS entry point (design Section 9.6).
#
# One site, HOST_DOMAIN, with an automatic certificate. Caddy terminates TLS
# and hands every request to nginx (nginx.conf.template), which routes to api
# or web following core/docs/deployment.md, "Routing", and rate-limits the
# credential endpoints per client address. Caddy has no rate limiting of its
# own, and core keys its per-IP limits on the direct peer, which behind a
# proxy is the proxy: the per-IP limiting has to happen in front of the api.
#
#   /healthz, /readyz, /metrics   404 here; they are for the server only
#   every other path              nginx
#
# Caddy sets X-Forwarded-For to the client's address and ignores any value
# the client sent (no trusted_proxies), so nginx can trust the header from
# this container alone. lb_try_duration covers the moment nginx is recreated
# by a deployment.

{$HOST_DOMAIN} {
	@internal path /healthz /healthz/* /readyz /readyz/* /metrics /metrics/*
	handle @internal {
		respond 404
	}

	handle {
		reverse_proxy nginx:8080 {
			lb_try_duration 10s
		}
	}
}
